{
  "name": "gift",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "judge": "node packages/judge/src/cli.ts",
    "play": "node packages/judge/src/play.ts",
    "site": "node packages/tools/src/judge-all.ts && pnpm -F @gift/site build",
    "site:dev": "pnpm -F @gift/site dev",
    "test": "pnpm -r test",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck"
  },
  "dependencies": {
    "@gift/judge": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
